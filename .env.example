# Sendoff environment variables. Copy to .env and fill in. Placeholders only —
# never commit real values. Every var here has a safe default in code except the
# secrets (Gmail OAuth, MCP key, ActiveRecord encryption keys).

# --- LLM ---------------------------------------------------------------------
# Path to the `claude` CLI binary used by LLM::ClaudeCliClient. Defaults to
# `claude` on PATH if unset.
SENDOFF_CLAUDE_BIN=claude

# --- Send safety -------------------------------------------------------------
SENDOFF_SEND_DAILY_CAP=20            # max emails sent per day
SENDOFF_SEND_HOURLY_CAP=5            # max emails sent per hour
SENDOFF_RECIPIENT_COOLDOWN_DAYS=7    # don't re-contact the same recipient within N days
SENDOFF_LEAD_FRESH_TOUCH_DAYS=4      # a lead touched within N days counts as "fresh"

# --- Gmail -------------------------------------------------------------------
GMAIL_DRY_RUN=true                          # if true, log outbound mail instead of sending
GMAIL_OAUTH_CLIENT_ID=your-client-id        # Google OAuth client ID for the Gmail API
GMAIL_OAUTH_CLIENT_SECRET=your-client-secret # Google OAuth client secret

# --- MCP server --------------------------------------------------------------
SENDOFF_MCP_API_KEY=generate-a-long-random-string # required X-API-KEY for POST /mcp

# --- ActiveRecord encryption -------------------------------------------------
# Used to encrypt stored OAuth refresh tokens. Generate with:
#   bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=generate-me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=generate-me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=generate-me
