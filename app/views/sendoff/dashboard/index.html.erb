<% content_for :title, "Dashboard" %>

<div class="page-head">
  <h1>Dashboard</h1>
</div>

<div class="kanban-board" style="grid-auto-columns: minmax(140px, 1fr); margin-bottom: 24px;">
  <% Sendoff::PipelineEntry.stages.keys.each do |stage| %>
    <div class="sdr-card" style="text-align:center;">
      <div style="font-size:28px; font-weight:700;"><%= @counts[stage].to_i %></div>
      <div class="muted" style="text-transform:capitalize;"><%= stage %></div>
    </div>
  <% end %>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px;">
  <div class="sdr-card">
    <div class="page-head"><h1 style="font-size:16px;">Drafts to review</h1></div>
    <% if @drafts_to_review.any? %>
      <table class="table">
        <% @drafts_to_review.each do |draft| %>
          <tr>
            <td><%= draft.lead&.email %></td>
            <td class="muted"><%= truncate(draft.subject.to_s, length: 40) %></td>
            <td style="text-align:right;"><%= link_to "Review", edit_draft_path(draft), class: "btn btn-sm" %></td>
          </tr>
        <% end %>
      </table>
    <% else %>
      <div class="sdr-empty">No drafts waiting.</div>
    <% end %>
  </div>

  <div class="sdr-card">
    <div class="page-head"><h1 style="font-size:16px;">Recent leads</h1></div>
    <% if @recent_leads.any? %>
      <table class="table">
        <% @recent_leads.each do |lead| %>
          <tr>
            <td><%= link_to lead.email, lead_path(lead) %></td>
            <td class="muted"><%= lead.company&.name %></td>
          </tr>
        <% end %>
      </table>
    <% else %>
      <div class="sdr-empty">No leads yet — run <code>rake app:sendoff:demo</code>.</div>
    <% end %>
  </div>
</div>
